# Pure cmake script to write out joliputty-version.h: JoliPuTTY's
# version, from the nearest joliputty-X.Y tag in the history of the
# current commit, and the release of PuTTY it's based on, from PuTTY's
# nearest X.YY tag.
#
# On the joliputty-0.2 tag itself, the version is 0.2, and it's a
# release (the only kind of build the msi and msix targets will
# package). Five commits later, it's 0.2-5-gabc1234, with -dirty if
# there are uncommitted changes. With no tag, or no git, it's "dev".

set(version "dev")
set(binary_version "0,0,0,0")
set(release 0)
set(base "")

function(git_describe outvar)
  execute_process(
    COMMAND ${GIT_EXECUTABLE} describe --tags ${ARGN}
    OUTPUT_VARIABLE out
    ERROR_VARIABLE stderr
    RESULT_VARIABLE status
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(status EQUAL 0)
    set(${outvar} "${out}" PARENT_SCOPE)
  else()
    set(${outvar} "" PARENT_SCOPE)
  endif()
endfunction()

execute_process(
  COMMAND ${GIT_EXECUTABLE} rev-parse --show-cdup
  OUTPUT_VARIABLE path_to_top
  ERROR_VARIABLE stderr
  RESULT_VARIABLE status)
string(REGEX REPLACE "\n$" "" path_to_top "${path_to_top}")

# (as in gitcommit.cmake: only if the source dir is the top of a git
# repository, and not inside some other one)
if(status EQUAL 0 AND path_to_top STREQUAL "")
  git_describe(jp --match "joliputty-*" --dirty)
  if(jp MATCHES "^joliputty-(.+)$")
    set(version "${CMAKE_MATCH_1}")
    if(version MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?")
      set(build "${CMAKE_MATCH_4}")
      if(build STREQUAL "")
        set(build 0)
      endif()
      set(binary_version "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${build},0")
    endif()
    if(version MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
      set(release 1)
    endif()
  else()
    message("No joliputty-* tag before the current commit: JoliPuTTY's version is \"dev\"")
  endif()

  git_describe(base --match "[0-9]*" --abbrev=0)
else()
  message("Unable to determine JoliPuTTY's version from git: it's \"dev\"")
endif()

# (without git, the release of PuTTY in the source tree)
if(base STREQUAL "")
  file(STRINGS ${CMAKE_SOURCE_DIR}/LATEST.VER base LIMIT_COUNT 1)
endif()

file(WRITE "${OUTPUT_FILE}" "\
/*
 * joliputty-version.h - JoliPuTTY's version, and PuTTY's it's based on.
 *
 * Generated by cmake/joliputty-version.cmake.
 */

#define JOLIPUTTY_VERSION \"${version}\"
#define JOLIPUTTY_BASE \"${base}\"
#define JOLIPUTTY_RELEASE ${release}
#define JOLIPUTTY_TEXTVER \"JoliPuTTY ${version}\"
#define JOLIPUTTY_BINARY_VERSION ${binary_version}
")
